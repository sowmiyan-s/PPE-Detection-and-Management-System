# ==============================================================================
# EdgeVision / Cerberus AI - Jetson Orin Environment Configuration
# ==============================================================================

# Hardware Acceleration & Optimization Profile
PERFORMANCE_PROFILE=jetson
INFERENCE_IMG_SIZE=640
INFERENCE_HALF_PRECISION=true
CUDA_VISIBLE_DEVICES=0

# Model Paths (TensorRT FP16 engine preferred)
MODEL_PATH=models/best.engine
FALLBACK_MODEL_PATH=models/best.pt
DETECTION_CONF=0.40

# Server Binding
SERVER_HOST=0.0.0.0
PORT=8000

# Primary Video Feed (0 for /dev/video0 USB, csi://0 for MIPI CSI, or RTSP URL)
CAMERA_SOURCE=0
TARGET_FPS=30
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# Safety Zone Rules
DEFAULT_ZONE=General Plant Floor
TEMPORAL_WINDOW=10
TEMPORAL_MIN_HITS=8
TEMPORAL_MIN_CONF=0.20
TEMPORAL_MIN_ZONE_SECS=3.0

# Database (Fast, embedded SQLite WAL mode on Jetson NVMe storage)
DB_ENGINE=sqlite

# MQTT Event Publisher (Optional industrial broker)
MQTT_BROKER=test.mosquitto.org
MQTT_PORT=1883
MQTT_TOPIC=factory/ppe_violations
